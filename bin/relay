#!/usr/bin/env bash
# relay - the DashLLM relay under GAIFA: start/stop/restart/logs go through `gaifa`, for both the
# relay and the OpenCode agent server it routes to (the old relay.service / opencode.service pair).
#
#   relay start | stop | restart | status | logs [-f] | open     (--relay-only: leave opencode alone)
set -euo pipefail
ROOT="$(cd "$(dirname "$(readlink -f "$0")")/.." && pwd)"
GAIFA="$ROOT/../../bin/gaifa"
mods=(opencode relay)
args=()
for a in "$@"; do [[ "$a" == --relay-only ]] && mods=(relay) || args+=("$a"); done
cmd="${args[0]:-status}"
case "$cmd" in
  start) for m in "${mods[@]}"; do "$GAIFA" start "$m"; done ;;
  stop) "$GAIFA" stop relay; [[ ${#mods[@]} -gt 1 ]] && "$GAIFA" stop opencode || true ;;
  restart) for m in "${mods[@]}"; do "$GAIFA" restart "$m"; done ;;
  status) "$GAIFA" status | awk 'NR == 1 || $1 == "MOD" || $1 == "relay" || $1 == "opencode"' ;;
  logs) "$GAIFA" logs relay "${args[@]:1}" ;;
  open) exec "$GAIFA" open "#/s/relay" ;;
  -h|--help|help) sed -n '2,5p' "$0" ;;
  *) echo "relay: unknown command $cmd (start|stop|restart|status|logs|open)" >&2; exit 2 ;;
esac
