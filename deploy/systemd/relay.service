# TEMPLATE. @REPO_ROOT@ is substituted with this clone's absolute path by
# scripts/install-systemd.sh. Do not hardcode a path here: the installed unit
# must follow wherever the repo actually lives, and a value baked into this
# file is silently reverted the next time the installer runs.
[Unit]
Description=DashLLM relay - OpenAI-compatible LLM proxy + dashboard
# relay comes up on boot and serves the dashboard + proxy. It does NOT connect
# any SSH tunnel on its own: tunnel-backed endpoints (e.g. skynet) are connected
# manually from the Endpoints screen, where prompts are answered interactively.
# Local model servers are started on demand by lcpp (~/Models/LLMs), which
# registers each one here over /admin/registrations and retries until relay
# answers, so neither service waits for the other; ordering after lcpp.service
# only makes a boot-time reconcile land sooner.
After=network-online.target lcpp.service
Wants=network-online.target
# Bring the OpenCode agent server up with relay, and (via its PartOf=) take it
# down with relay. Wants= not Requires=: a missing or misconfigured agent
# server must not stop the proxy from serving every other endpoint.
Wants=opencode.service
Before=opencode.service

[Service]
Type=simple
WorkingDirectory=@REPO_ROOT@/web/backend
# The wrapper sources .env and takes RELAY_HOST / RELAY_PORT from it, so the
# bind address is configuration rather than a value baked into this file that
# a re-install would silently revert. uv resolves the project venv from the
# pyproject.toml in WorkingDirectory.
ExecStart=@REPO_ROOT@/scripts/relay-serve.sh
Restart=always
RestartSec=5
# `uv` traps SIGTERM and exits 143 (128+15) rather than dying from the signal,
# so without this a clean `relay stop` parks the unit in `failed` — alarming in
# status output and a false alarm for anything watching unit state.
SuccessExitStatus=143
Environment=PYTHONUNBUFFERED=1
# Persist runtime state (registered endpoints, telemetry) under the repo.
# .env wins over these if it sets them.
Environment=RELAY_DB_PATH=@REPO_ROOT@/web/backend/data/relay.db
Environment=RELAY_LOG_DIR=@REPO_ROOT@/web/backend/logs

[Install]
WantedBy=default.target
